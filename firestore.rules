rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Reels
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Reel views: each viewer writes their own marker, only the reel's owner can read them
      match /views/{viewerId} {
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid;
        allow create, update: if signedIn() && request.auth.uid == viewerId;
      }

      match /shares/{shareUserId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == shareUserId;
      }

      match /saves/{saveUserId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == saveUserId;
      }

      match /likes/{likeUserId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == likeUserId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }
    }

    // Profiles (+ private data that only the owner / allowed people can read)
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // Stories: only the owner and people who follow the owner
      match /stories/{storyId} {
        allow read: if signedIn() && (request.auth.uid == uid ||
          exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)));
        allow write: if signedIn() && request.auth.uid == uid;

        // Story views: viewers write their own marker, only the story owner reads them
        match /views/{viewerId} {
          allow read: if signedIn() && request.auth.uid == uid;
          allow create, update: if signedIn() && request.auth.uid == viewerId;
        }
      }

      // Close-friends stories: only the owner and people on the close friends list
      match /closeStories/{storyId} {
        allow read: if signedIn() && (request.auth.uid == uid ||
          exists(/databases/$(database)/documents/users/$(uid)/closeFriends/$(request.auth.uid)));
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // Notifications: anyone signed in can send one to you, only you can read or clear them
      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.resource.data.fromId == request.auth.uid && request.auth.uid != uid;
      }

      // Profile visits and follow / unfollow history: written by the other person, read only by the owner
      match /visits/{visitId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.resource.data.visitorId == request.auth.uid;
      }

      match /followEvents/{eventId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      }

      match /closeFriends/{friendId} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendId);
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Following
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        followId == request.auth.uid + '_' + request.resource.data.followingId;
      allow delete: if signedIn() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followingId == request.auth.uid);
    }

    // Messages
    match /chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn() &&
          request.resource.data.from == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
