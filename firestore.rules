rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Ads: paid through Razorpay, approved by the admin before they run
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'vvvv04431@gmail.com' && request.auth.token.email_verified == true;
    }
    match /ads/{adId} {
      allow read: if resource.data.status == 'approved' || (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.paymentId is string;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Naat library: everyone signed in can listen, only the admin adds tracks
    match /naats/{naatId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Reels
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Reel views: each viewer writes their own marker, only the reel's owner can read them
      match /views/{viewerId} {
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid;
        allow create, update: if signedIn() && request.auth.uid == viewerId;
      }

      // one marker per (sharer, recipient): id is "<sharerUid>_<recipient>"
      match /shares/{shareId} {
        allow read: if true;
        allow write: if signedIn() && (request.auth.uid == shareId || shareId.matches(request.auth.uid + '_.*'));
      }

      match /saves/{saveUserId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == saveUserId;
      }

      match /likes/{likeUserId} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == likeUserId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }
    }

    // Profiles (+ private data that only the owner / allowed people can read)
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // Stories: everyone can see a public account's stories; a private account's only its owner and followers
      match /stories/{storyId} {
        allow read: if signedIn() && (request.auth.uid == uid ||
          exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)) ||
          !exists(/databases/$(database)/documents/users/$(uid)) ||
          get(/databases/$(database)/documents/users/$(uid)).data.get('isPrivate', false) == false);
        allow write: if signedIn() && request.auth.uid == uid;

        // Story views: viewers write their own marker, only the story owner reads them
        match /views/{viewerId} {
          allow read: if signedIn() && request.auth.uid == uid;
          allow create, update: if signedIn() && request.auth.uid == viewerId;
        }
      }

      // Highlights follow the same visibility as stories
      match /highlights/{highlightId} {
        allow read: if signedIn() && (request.auth.uid == uid ||
          exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)) ||
          !exists(/databases/$(database)/documents/users/$(uid)) ||
          get(/databases/$(database)/documents/users/$(uid)).data.get('isPrivate', false) == false);
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // Close-friends stories: only the owner and people on the close friends list
      match /closeStories/{storyId} {
        allow read: if signedIn() && (request.auth.uid == uid ||
          exists(/databases/$(database)/documents/users/$(uid)/closeFriends/$(request.auth.uid)));
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // Push tokens of this user's phones (written by the app, read by the push server's service account)
      match /tokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Notifications: anyone signed in can send one to you, only you can read or clear them
      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.resource.data.fromId == request.auth.uid && request.auth.uid != uid;
      }

      // Profile visits and follow / unfollow history: written by the other person, read only by the owner
      match /visits/{visitId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.resource.data.visitorId == request.auth.uid;
      }

      match /followEvents/{eventId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      }

      match /closeFriends/{friendId} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendId);
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Follow requests for private accounts
    match /followRequests/{requestId} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid &&
        requestId == request.auth.uid + '_' + request.resource.data.to;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Following
    match /follows/{followId} {
      allow read: if signedIn();
      // follow a public account directly; a private account needs a request the owner accepts
      allow create: if signedIn() && (
        (request.resource.data.followerId == request.auth.uid &&
          followId == request.auth.uid + '_' + request.resource.data.followingId &&
          (!exists(/databases/$(database)/documents/users/$(request.resource.data.followingId)) ||
            get(/databases/$(database)/documents/users/$(request.resource.data.followingId)).data.get('isPrivate', false) == false)) ||
        (request.resource.data.followingId == request.auth.uid &&
          followId == request.resource.data.followerId + '_' + request.auth.uid &&
          exists(/databases/$(database)/documents/followRequests/$(followId))));
      allow delete: if signedIn() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followingId == request.auth.uid);
    }

    // Messages
    match /chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn() &&
          request.resource.data.from == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Audio / video calls: signalling data shared by the two people
    match /calls/{callId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.caller || request.auth.uid == resource.data.callee);
      allow create: if signedIn() && request.resource.data.caller == request.auth.uid;
      allow update, delete: if signedIn() && (request.auth.uid == resource.data.caller || request.auth.uid == resource.data.callee);

      match /{side}/{candidateId} {
        allow read, write: if signedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.caller ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callee);
      }
    }

    // Group chats
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members &&
        request.auth.uid in request.resource.data.admins && request.resource.data.members.size() <= 50;
      // any member may touch chat state and look settings; admins may change anything (name, photo, members)
      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        request.auth.uid in resource.data.admins ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['lastMessage', 'lastAt', 'lastSender', 'lastRead', 'muted', 'theme', 'font', 'disappear', 'clearedAt', 'members', 'admins']) &&
        // a non-admin changing members/admins may only be removing themselves
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'admins']) ||
          (!(request.auth.uid in request.resource.data.members) &&
           request.resource.data.members.size() == resource.data.members.size() - 1))
      );

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    // Group calls: a room that group members join (mesh WebRTC signalling)
    match /gcalls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members && request.resource.data.host == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.members;

      match /{any=**} {
        allow read, write: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/gcalls/$(callId)).data.members;
      }
    }
  }
}
