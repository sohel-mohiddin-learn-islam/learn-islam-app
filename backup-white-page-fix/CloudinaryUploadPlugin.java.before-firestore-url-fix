package com.sohel.learnislam;

import android.util.Base64;

import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.JSObject;
import com.getcapacitor.annotation.CapacitorPlugin;
import com.google.firebase.auth.FirebaseAuth;
import com.google.firebase.auth.FirebaseUser;

import java.io.ByteArrayOutputStream;
import java.io.DataOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.InputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.net.URLEncoder;

@CapacitorPlugin(name = "CloudinaryUpload")
public class CloudinaryUploadPlugin extends Plugin {

    @PluginMethod
    public void upload(PluginCall call) {
        String filePath = call.getString("filePath");
        String userId = call.getString("userId");

        if (filePath == null || filePath.isEmpty()) {
            call.reject("Missing file path.");
            return;
        }

        if (userId == null) {
            userId = "";
        }

        final String finalUserId = userId;

        new Thread(() -> {
            HttpURLConnection connection = null;

            try {
                File file = new File(filePath);

                if (!file.exists()) {
                    call.reject("Video file not found.");
                    return;
                }

                String boundary = "----LearnIslamCloudinary" + System.currentTimeMillis();

                URL url = new URL(
                    "https://api.cloudinary.com/v1_1/mpyzgv8c/video/upload"
                );

                connection = (HttpURLConnection) url.openConnection();
                connection.setRequestMethod("POST");
                connection.setDoOutput(true);
                connection.setConnectTimeout(30000);
                connection.setReadTimeout(120000);
                connection.setRequestProperty(
                    "Content-Type",
                    "multipart/form-data; boundary=" + boundary
                );

                DataOutputStream output =
                    new DataOutputStream(connection.getOutputStream());

                writeField(output, boundary, "upload_preset", "learn_islam_reels");
                writeField(output, boundary, "context", "userId=" + finalUserId);

                output.writeBytes("--" + boundary + "\r\n");
                output.writeBytes(
                    "Content-Disposition: form-data; name=\"file\"; filename=\"" +
                    file.getName() + "\"\r\n"
                );
                output.writeBytes("Content-Type: video/mp4\r\n\r\n");

                FileInputStream input = new FileInputStream(file);
                byte[] buffer = new byte[8192];
                int bytesRead;

                while ((bytesRead = input.read(buffer)) != -1) {
                    output.write(buffer, 0, bytesRead);
                }

                input.close();

                output.writeBytes("\r\n--" + boundary + "--\r\n");
                output.flush();
                output.close();

                int responseCode = connection.getResponseCode();

                java.io.InputStream responseStream =
                    responseCode >= 400
                        ? connection.getErrorStream()
                        : connection.getInputStream();

                ByteArrayOutputStream responseBuffer =
                    new ByteArrayOutputStream();

                if (responseStream != null) {
                    byte[] responseBytes = new byte[8192];
                    int count;

                    while ((count = responseStream.read(responseBytes)) != -1) {
                        responseBuffer.write(responseBytes, 0, count);
                    }

                    responseStream.close();
                }

                String response =
                    responseBuffer.toString("UTF-8");

                if (responseCode < 200 || responseCode >= 300) {
                    call.reject(
                        "Cloudinary upload failed (" +
                        responseCode +
                        "): " +
                        response
                    );
                    return;
                }

                String secureUrl = extractJsonString(
                    response,
                    "secure_url"
                );

                if (secureUrl == null) {
                    call.reject("Cloudinary did not return a video URL.");
                    return;
                }

                JSObject result = new JSObject();
                result.put("secure_url", secureUrl);

                call.resolve(result);

            } catch (Exception e) {
                call.reject(
                    "Native Cloudinary upload failed: " +
                    e.getMessage()
                );
            } finally {
                if (connection != null) {
                    connection.disconnect();
                }
            }
        }).start();
    }

    @PluginMethod
    public void uploadBase64(PluginCall call) {
        String base64 = call.getString("base64");
        String userId = call.getString("userId");
        if (base64 == null || base64.isEmpty()) {
            call.reject("Missing video data.");
            return;
        }
        if (userId == null) userId = "";
        final String finalUserId = userId;
        new Thread(() -> {
            HttpURLConnection connection = null;
            File tempFile = null;
            try {
                byte[] videoBytes = Base64.decode(base64, Base64.DEFAULT);
                tempFile = new File(getContext().getCacheDir(), "reel_" + System.currentTimeMillis() + ".mp4");
                java.io.FileOutputStream fos = new java.io.FileOutputStream(tempFile);
                fos.write(videoBytes);
                fos.close();
                String boundary = "----LearnIslamCloudinary" + System.currentTimeMillis();
                URL url = new URL("https://api.cloudinary.com/v1_1/mpyzgv8c/video/upload");
                connection = (HttpURLConnection) url.openConnection();
                connection.setRequestMethod("POST");
                connection.setDoOutput(true);
                connection.setConnectTimeout(30000);
                connection.setReadTimeout(120000);
                connection.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);
                DataOutputStream output = new DataOutputStream(connection.getOutputStream());
                writeField(output, boundary, "upload_preset", "learn_islam_reels");
                writeField(output, boundary, "context", "userId=" + finalUserId);
                output.writeBytes("--" + boundary + "\r\n");
                output.writeBytes("Content-Disposition: form-data; name=\"file\"; filename=\"reel.mp4\"\r\n");
                output.writeBytes("Content-Type: video/mp4\r\n\r\n");
                FileInputStream input = new FileInputStream(tempFile);
                byte[] buffer = new byte[8192];
                int bytesRead;
                while ((bytesRead = input.read(buffer)) != -1) output.write(buffer, 0, bytesRead);
                input.close();
                output.writeBytes("\r\n--" + boundary + "--\r\n");
                output.flush();
                output.close();
                int responseCode = connection.getResponseCode();
                java.io.InputStream responseStream = responseCode >= 400 ? connection.getErrorStream() : connection.getInputStream();
                ByteArrayOutputStream responseBuffer = new ByteArrayOutputStream();
                if (responseStream != null) {
                    byte[] responseBytes = new byte[4096];
                    int read;
                    while ((read = responseStream.read(responseBytes)) != -1) responseBuffer.write(responseBytes, 0, read);
                    responseStream.close();
                }
                String response = responseBuffer.toString("UTF-8");
                if (responseCode < 200 || responseCode >= 300) {
                    call.reject("Cloudinary upload failed (" + responseCode + "): " + response);
                    return;
                }
                String secureUrl = extractJsonString(response, "secure_url");
                if (secureUrl == null) {
                    call.reject("Cloudinary did not return a video URL.");
                    return;
                }
                JSObject result = new JSObject();
                result.put("secure_url", secureUrl);
                call.resolve(result);
            } catch (Exception e) {
                call.reject("Native Base64 Cloudinary upload failed: " + e.getMessage());
            } finally {
                if (connection != null) connection.disconnect();
                if (tempFile != null && tempFile.exists()) tempFile.delete();
            }
        }).start();
    }
    private void writeField(
        DataOutputStream output,
        String boundary,
        String name,
        String value
    ) throws Exception {
        output.writeBytes("--" + boundary + "\r\n");
        output.writeBytes(
            "Content-Disposition: form-data; name=\"" +
            name +
            "\"\r\n\r\n"
        );
        output.writeBytes(value + "\r\n");
    }

    private String extractJsonString(
        String json,
        String key
    ) {
        String search = "\"" + key + "\"";
        int keyIndex = json.indexOf(search);

        if (keyIndex < 0) {
            return null;
        }

        int colon = json.indexOf(":", keyIndex);
        int firstQuote = json.indexOf("\"", colon + 1);

        if (firstQuote < 0) {
            return null;
        }

        int secondQuote =
            json.indexOf("\"", firstQuote + 1);

        if (secondQuote < 0) {
            return null;
        }

        return json.substring(
            firstQuote + 1,
            secondQuote
        );
    }
    @PluginMethod
    public void createPost(PluginCall call) {
        String userId = call.getString("userId");
        String userName = call.getString("userName");
        String userPhoto = call.getString("userPhoto");
        String caption = call.getString("caption");
        String videoUrl = call.getString("videoUrl");

        if (userId == null || userId.isEmpty()) {
            call.reject("Missing user ID.");
            return;
        }

        if (videoUrl == null || videoUrl.isEmpty()) {
            call.reject("Missing video URL.");
            return;
        }

        FirebaseUser user = FirebaseAuth.getInstance().getCurrentUser();
        if (user == null) {
            call.reject("Firebase user is not signed in.");
            return;
        }

        user.getIdToken(false).addOnSuccessListener(tokenResult -> {
            String idToken = tokenResult.getToken();

            if (idToken == null || idToken.isEmpty()) {
                call.reject("Firebase ID token is empty.");
                return;
            }

            new Thread(() -> {
                HttpURLConnection connection = null;

                try {
                    URL url = new URL(
                        "https://firestore.asia-south1.rep.googleapis.com/v1/projects/learn-islam-891c3/databases/default/documents/posts"
                    );

                    connection = (HttpURLConnection) url.openConnection();
                    connection.setRequestMethod("POST");
                    connection.setConnectTimeout(15000);
                    connection.setReadTimeout(30000);
                    connection.setDoOutput(true);
                    connection.setRequestProperty("Authorization", "Bearer " + idToken);
                    connection.setRequestProperty("Content-Type", "application/json; charset=UTF-8");

                    java.text.SimpleDateFormat sdf =
                        new java.text.SimpleDateFormat(
                            "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                            java.util.Locale.US
                        );
                    sdf.setTimeZone(java.util.TimeZone.getTimeZone("UTC"));
                    String timestamp = sdf.format(new java.util.Date());

                    String json =
                        "{\"fields\":{" +
                        "\"userId\":{\"stringValue\":\"" + escapeJson(userId) + "\"}," +
                        "\"userName\":{\"stringValue\":\"" + escapeJson(userName == null ? "" : userName) + "\"}," +
                        "\"userPhoto\":{\"stringValue\":\"" + escapeJson(userPhoto == null ? "" : userPhoto) + "\"}," +
                        "\"caption\":{\"stringValue\":\"" + escapeJson(caption == null ? "" : caption) + "\"}," +
                        "\"videoUrl\":{\"stringValue\":\"" + escapeJson(videoUrl) + "\"}," +
                        "\"createdAt\":{\"timestampValue\":\"" + timestamp + "\"}" +
                        "}}";

                    DataOutputStream output =
                        new DataOutputStream(connection.getOutputStream());
                    output.write(json.getBytes("UTF-8"));
                    output.flush();
                    output.close();

                    int status = connection.getResponseCode();

                    InputStream responseStream =
                        status >= 200 && status < 300
                            ? connection.getInputStream()
                            : connection.getErrorStream();

                    String response = "";

                    if (responseStream != null) {
                        java.util.Scanner scanner =
                            new java.util.Scanner(responseStream).useDelimiter("\\A");
                        response = scanner.hasNext() ? scanner.next() : "";
                        scanner.close();
                    }

                    android.util.Log.d(
                        "CloudinaryUpload",
                        "FIRESTORE REST HTTP = " + status
                    );
                    android.util.Log.d(
                        "CloudinaryUpload",
                        "FIRESTORE REST RESPONSE = " + response
                    );

                    if (status >= 200 && status < 300) {
                        JSObject result = new JSObject();
                        int slash = response.lastIndexOf("/");
                        String name =
                            slash >= 0
                                ? response.substring(slash + 1)
                                : "";

                        result.put("name", name);

                        getActivity().runOnUiThread(
                            () -> call.resolve(result)
                        );
                    } else {
                        String error =
                            "Firestore REST failed HTTP " + status;

                        if (response.length() > 0) {
                            error += ": " + response;
                        }

                        String finalError = error;

                        getActivity().runOnUiThread(
                            () -> call.reject(finalError)
                        );
                    }

                } catch (Exception e) {
                    android.util.Log.e(
                        "CloudinaryUpload",
                        "FIRESTORE REST ERROR",
                        e
                    );

                    String message =
                        e.getMessage() == null
                            ? e.toString()
                            : e.getMessage();

                    getActivity().runOnUiThread(
                        () -> call.reject("Firestore REST error: " + message)
                    );

                } finally {
                    if (connection != null) {
                        connection.disconnect();
                    }
                }
            }).start();

        }).addOnFailureListener(
            e -> call.reject(
                "Firebase ID token failed: " + e.getMessage()
            )
        );
    }

    private String escapeJson(String value) {
        if (value == null) return "";

        return value
            .replace("\\", "\\\\")
            .replace("\"", "\\\"")
            .replace("\r", "\\r")
            .replace("\n", "\\n");
    }

}
